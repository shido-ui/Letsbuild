ENVIRONMENT=development
DATABASE_URL=sqlite:///./data/moduleiq.db
STORAGE_ROOT=./data/storage
LOG_LEVEL=INFO
# Provider credentials are intentionally NOT stored in source control.
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Required for encrypted BYOK credentials; generate a random secret and keep it outside git.
MODULEIQ_CREDENTIAL_ENCRYPTION_KEY=change-me-in-local-env
